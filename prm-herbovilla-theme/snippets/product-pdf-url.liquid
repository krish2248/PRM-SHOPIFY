{%- comment -%}
  Product presentation resolver (rewritten 2026-11-11).

  Returns every presentation PDF (stored in theme assets/) for a product, as
  comma-separated "url|Label" entries. Combo listings return one entry per component.
  Outputs a blank string when there is no PDF.

  Usage:
    {%- capture pdf_list -%}{%- render 'product-pdf-url', product: product -%}{%- endcapture -%}
    {%- assign pdf_entries = pdf_list | strip | split: ',' -%}

  Matching:
    1. Combo listings, matched by handle (combo handles are clean).
    2. Everything else is matched on the TITLE first, because several live handles
       name a different product than their title (e.g. the handle says "syrup" but the
       product is the soap). The handle is used only when the title names no brand.
       Brand = first known brand word; form = the EARLIEST form word in the text
       (syrup / tablet / capsule / soap / cream / oil / gel ...), so a later mention
       such as "Olive Oil" in a soap title doesn't win.
{%- endcomment -%}

{%- liquid
  assign files = ''
  assign h = product.handle | downcase

  comment
    1. Combos: one PDF per component (components without a PDF are skipped).
  endcomment
  case h
    when 'arthovilla-oil-syrup-combo'
      assign files = 'artho-oil.pdf,artho-syrup.pdf'
    when 'cofula-vedacold-combo'
      assign files = 'cofula-syrup.pdf'
    when 'dermovilla-syrup-tablets'
      assign files = 'dermo-syrup.pdf'
    when 'hair-marshal-prolice-oil-combo'
      assign files = 'hair-marshal.pdf,prolice-herbal-oil.pdf'
    when 'harry-syrup-tablets'
      assign files = 'harry-syrup.pdf'
    when 'prolax-tab-syrup-combo'
      assign files = 'prolax-tabs.pdf,prolax-syrup.pdf'
    when 'pynil-oitment-capsules-combo'
      assign files = 'pynil-oint.pdf,pynil-caps.pdf'
    when 'saheli-soap-cream-combo'
      assign files = 'saheli-soap.pdf,saheli-cream.pdf'
    when 'platigen-syrup-tablets-combo', 'rome-oil-capsules', 'zymovilla-syrup-tablets-combo'
      assign files = 'none'
  endcase

  comment
    2. Single products: title first, then handle.
  endcomment
  if files == ''
    assign t_src = product.title | downcase
    assign h_src = h | replace: '-', ' '
    assign sources = t_src | append: '~~' | append: h_src | split: '~~'
    comment
      Brands without a PDF yet (rome, platigem, zymo ...) are listed too, so an ingredient
      word in their title (e.g. "kesar" in Rome Oil) can't pick another product's PDF.
      The brand that appears EARLIEST in the text wins; at the same position the earlier
      list entry wins, so longer names come first ('harry g ' before 'harry').
    endcomment
    assign brand_list = 'castrowin,castor,castro,aahaa,aaha,hair marshal,hairmarshal,prolice,icee, lee ,harry g ,harry,saheli,dermo neem,dermo,steno,prince,kesar,dyril,obee,gluco,breno,pynil,prolax,itchi,cut care,cofula junior,cofula,artho,rome,platigem,platigen,zymo,aloy,calcy,fenny,vedacold,inhaler' | split: ','
    assign form_list = 'syrup,tablet, tabs,capsule,caps,ointment,soap,cream,oil,gel,liquid,powder,drops,tonic' | split: ','

    for src in sources
      assign s = ' ' | append: src | append: ' '
      assign brand = ''
      assign brand_pos = 100000
      for b in brand_list
        if s contains b
          assign bpos = s | split: b | first | size
          if bpos < brand_pos
            assign brand_pos = bpos
            assign brand = b | strip
          endif
        endif
      endfor
      if brand == ''
        continue
      endif

      assign form = ''
      assign best = 100000
      for f in form_list
        if s contains f
          assign pos = s | split: f | first | size
          if pos < best
            assign best = pos
            assign form = f | strip
          endif
        endif
      endfor
      if form == 'tabs'
        assign form = 'tablet'
      elsif form == 'caps'
        assign form = 'capsule'
      elsif form == 'oint'
        assign form = 'ointment'
      endif

      case brand
        when 'castrowin'
          assign files = 'castrowin-softgel.pdf'
        when 'castor', 'castro'
          assign files = 'castro-softgel.pdf'
        when 'aahaa', 'aaha'
          assign files = 'aahaa-gel.pdf'
        when 'hair marshal', 'hairmarshal'
          assign files = 'hair-marshal.pdf'
        when 'prolice'
          assign files = 'prolice-herbal-oil.pdf'
        when 'icee'
          if s contains 'icee rd'
            assign files = 'icee-rd-caps.pdf'
          elsif form == 'capsule'
            assign files = 'icee-caps.pdf'
          else
            assign files = 'icee-syrup.pdf'
          endif
        when 'lee'
          if form == 'capsule'
            assign files = 'lee-caps.pdf'
          else
            assign files = 'lee-syrup.pdf'
          endif
        when 'harry g'
          assign files = 'harry-g.pdf'
        when 'harry'
          case form
            when 'drops'
              assign files = 'harry-drops.pdf'
            when 'powder'
              assign files = 'harry-powder.pdf'
            when 'capsule'
              assign files = 'harry-cap.pdf'
            else
              assign files = 'harry-syrup.pdf'
          endcase
        when 'saheli'
          case form
            when 'soap'
              assign files = 'saheli-soap.pdf'
            when 'cream'
              assign files = 'saheli-cream.pdf'
            else
              assign files = 'saheli-syrup.pdf'
          endcase
        when 'dermo neem'
          assign files = 'dermo-neem-soap.pdf'
        when 'dermo'
          case form
            when 'soap'
              assign files = 'dermo-soap.pdf'
            when 'capsule'
              assign files = 'dermo-cap.pdf'
            else
              assign files = 'dermo-syrup.pdf'
          endcase
        when 'steno'
          if form == 'tablet'
            assign files = 'stenovilla-tabs.pdf'
          else
            assign files = 'stenovilla-syrup.pdf'
          endif
        when 'prince'
          if form == 'gel'
            assign files = 'prince-mouth-gel.pdf'
          else
            assign files = 'prince-mouth-liquid.pdf'
          endif
        when 'kesar'
          assign files = 'kesar-baby-soap.pdf'
        when 'dyril'
          assign files = 'dyril-plus.pdf'
        when 'obee'
          assign files = 'obee-cap-oil.pdf'
        when 'gluco'
          assign files = 'gluco-villa.pdf'
        when 'breno'
          if form == 'syrup' or form == 'tonic'
            assign files = 'breno-syrup.pdf'
          else
            assign files = 'breno-caps.pdf'
          endif
        when 'pynil'
          if s contains 'combo'
            assign files = 'pynil-oint.pdf,pynil-caps.pdf'
          elsif form == 'ointment'
            assign files = 'pynil-oint.pdf'
          else
            assign files = 'pynil-caps.pdf'
          endif
        when 'prolax'
          if form == 'syrup'
            assign files = 'prolax-syrup.pdf'
          else
            assign files = 'prolax-tabs.pdf'
          endif
        when 'itchi'
          assign files = 'itchi-care.pdf'
        when 'cut care'
          assign files = 'cut-care-ointment.pdf'
        when 'cofula junior'
          assign files = 'cofula-junior.pdf'
        when 'cofula'
          assign files = 'cofula-syrup.pdf'
        when 'artho'
          case form
            when 'oil'
              assign files = 'artho-oil.pdf'
            when 'syrup'
              assign files = 'artho-syrup.pdf'
            else
              assign files = 'artho-tabs.pdf'
          endcase
        else
          comment
            No presentation yet (rome, platigem, zymo, aloy, calcy, fenny, vedacold, inhaler).
          endcomment
          assign files = 'none'
      endcase
      break
    endfor
  endif

  comment
    3. Build "url|Label" entries. Labels are used when a product has more than one PDF.
  endcomment
  assign out = ''
  if files != '' and files != 'none'
    assign file_arr = files | split: ','
    for file in file_arr
      case file
        when 'artho-oil.pdf'
          assign label = 'ArthoVilla Oil'
        when 'artho-syrup.pdf'
          assign label = 'ArthoVilla Syrup'
        when 'hair-marshal.pdf'
          assign label = 'Hair Marshal'
        when 'prolice-herbal-oil.pdf'
          assign label = 'Prolice Oil'
        when 'prolax-tabs.pdf'
          assign label = 'Prolax Tablets'
        when 'prolax-syrup.pdf'
          assign label = 'Prolax Syrup'
        when 'pynil-oint.pdf'
          assign label = 'Pynil Ointment'
        when 'pynil-caps.pdf'
          assign label = 'Pynil Capsules'
        when 'saheli-soap.pdf'
          assign label = 'Saheli Soap'
        when 'saheli-cream.pdf'
          assign label = 'Saheli Cream'
        else
          assign label = ''
      endcase
      assign entry = file | asset_url | append: '|' | append: label
      if out != ''
        assign out = out | append: ','
      endif
      assign out = out | append: entry
    endfor
  endif
  echo out
-%}
