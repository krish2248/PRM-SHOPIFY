{%- comment -%}
  Product card — one design used store-wide (homepage rows, collection grid).
  Uniform cream image tile, short title, ₹ price and a compact Add button
  below the price, so nothing covers the product photo.
  Styles: "PRODUCT CARD" block in assets/theme.css.

  Params:
  - product (required)
  - badge: optional label such as 'New'
  - show_vendor: defaults to true
  - lazy: pass false for cards visible on first paint
{%- endcomment -%}
{%- liquid
  if show_vendor == nil
    assign show_vendor = true
  endif
  assign loading = 'lazy'
  if lazy == false
    assign loading = 'eager'
  endif

  assign variant = product.selected_or_first_available_variant
  assign on_sale = false
  if variant.compare_at_price > variant.price
    assign on_sale = true
    assign savings = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price
  endif
-%}
{%- capture short_title -%}{%- render 'product-short-title', title: product.title -%}{%- endcapture -%}
{%- assign short_title = short_title | strip -%}

<div class="pcard{% unless product.available %} pcard--soldout{% endunless %}">
  <a href="{{ product.url }}" class="pcard__media" tabindex="-1" aria-hidden="true">
    {%- if product.featured_image != blank -%}
      <img
        class="pcard__img"
        src="{{ product.featured_image | image_url: width: 600 }}"
        srcset="{{ product.featured_image | image_url: width: 300 }} 300w, {{ product.featured_image | image_url: width: 450 }} 450w, {{ product.featured_image | image_url: width: 600 }} 600w"
        sizes="(max-width: 768px) 60vw, (max-width: 1200px) 30vw, 300px"
        alt="{{ product.featured_image.alt | default: short_title | escape }}"
        width="{{ product.featured_image.width }}"
        height="{{ product.featured_image.height }}"
        loading="{{ loading }}"
      >
      {%- if product.images[1] != blank -%}
        <img
          class="pcard__img pcard__img--alt"
          src="{{ product.images[1] | image_url: width: 600 }}"
          srcset="{{ product.images[1] | image_url: width: 300 }} 300w, {{ product.images[1] | image_url: width: 600 }} 600w"
          sizes="(max-width: 768px) 60vw, (max-width: 1200px) 30vw, 300px"
          alt=""
          width="{{ product.images[1].width }}"
          height="{{ product.images[1].height }}"
          loading="lazy"
        >
      {%- endif -%}
    {%- else -%}
      <span class="pcard__placeholder">{% render 'policy-icon', name: 'leaf' %}</span>
    {%- endif -%}
  </a>

  <div class="pcard__badges">
    {%- if product.available == false -%}
      <span class="pcard__badge pcard__badge--muted">Sold out</span>
    {%- elsif on_sale -%}
      <span class="pcard__badge pcard__badge--sale">{{ savings }}% off</span>
    {%- endif -%}
    {%- if badge != blank and product.available -%}
      <span class="pcard__badge">{{ badge }}</span>
    {%- endif -%}
  </div>

  <div class="pcard__body">
    {%- if show_vendor and product.vendor != blank -%}
      <p class="pcard__vendor">{{ product.vendor }}</p>
    {%- endif -%}
    <h3 class="pcard__title"><a href="{{ product.url }}" title="{{ product.title | escape }}">{{ short_title }}</a></h3>
    <div class="pcard__foot">
      <div class="pcard__price">
        <span class="pcard__price-now">{% render 'inr-price', cents: variant.price %}</span>
        {%- if on_sale -%}
          <s class="pcard__price-was">{% render 'inr-price', cents: variant.compare_at_price %}</s>
        {%- endif -%}
      </div>
      {%- if product.available -%}
        {%- if product.variants.size == 1 -%}
          <button
            type="button"
            class="pcard__add"
            data-add-to-cart
            data-variant-id="{{ variant.id }}"
            data-quantity="1"
            aria-label="Add {{ short_title | escape }} to cart"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>Add</span>
          </button>
        {%- else -%}
          <a class="pcard__add" href="{{ product.url }}" aria-label="Choose a size for {{ short_title | escape }}">Options</a>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</div>
