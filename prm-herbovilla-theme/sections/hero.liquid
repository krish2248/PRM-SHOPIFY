{%- comment -%}
  Hero — product-led. Left: headline, CTAs and trust chips (the "feature"
  blocks). Right: up to three product tiles picked in the theme editor
  (falls back to the first products of the Bestsellers collection).
  On phones the tiles sit in one compact row under the buttons so
  products are visible on the first screen.
{%- endcomment -%}
{%- liquid
  assign picks = ''
  if section.settings.product_1 != blank
    assign picks = picks | append: section.settings.product_1.handle | append: ','
  endif
  if section.settings.product_2 != blank
    assign picks = picks | append: section.settings.product_2.handle | append: ','
  endif
  if section.settings.product_3 != blank
    assign picks = picks | append: section.settings.product_3.handle | append: ','
  endif
  if picks == ''
    for p in collections['best-sellers'].products limit: 3
      assign picks = picks | append: p.handle | append: ','
    endfor
  endif
  assign pick_handles = picks | split: ','
-%}

{%- style -%}
  .hero2 {
    position: relative;
    overflow: hidden;
    padding: 56px 0 64px;
    background:
      radial-gradient(1200px 600px at 85% 20%, rgba(216, 236, 223, 0.55), rgba(216, 236, 223, 0) 60%),
      var(--color-background, #FDF8F0);
  }
  .hero2__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 56px;
    align-items: center;
  }
  .hero2__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    background: rgba(45, 106, 79, 0.08);
    border: 1px solid rgba(45, 106, 79, 0.18);
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 20px;
  }
  .hero2__eyebrow svg {
    width: 14px;
    height: 14px;
  }
  .hero2__title {
    font-family: var(--font-heading);
    font-size: clamp(2.3rem, 4.3vw, 3.5rem);
    line-height: 1.12;
    color: var(--color-text);
    margin: 0 0 20px;
  }
  .hero2__title em {
    font-style: normal;
    color: var(--color-primary);
  }
  .hero2__text {
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--color-text-light);
    max-width: 540px;
    margin: 0 0 30px;
  }
  .hero2__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 30px;
  }
  .hero2__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .hero2__chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: #fff;
    border: 1px solid #E5EDE4;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text);
  }
  .hero2__chip svg {
    width: 16px;
    height: 16px;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  /* Product stage */
  .hero2__stage {
    position: relative;
    width: 100%;
    max-width: 540px;
    aspect-ratio: 1 / 1;
    margin-left: auto;
  }
  .hero2__halo {
    position: absolute;
    inset: 4%;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #EAF4EC 0%, #D6EADC 48%, rgba(214, 234, 220, 0) 72%);
  }
  .hero2__leaf {
    position: absolute;
    color: rgba(45, 106, 79, 0.18);
  }
  .hero2__leaf--a { width: 90px; top: 2%; left: 8%; transform: rotate(-25deg); }
  .hero2__leaf--b { width: 70px; bottom: 4%; right: 10%; transform: rotate(140deg); }
  .hero2__tile {
    --tilt: 0deg;
    position: absolute;
    display: flex;
    flex-direction: column;
    padding: 12px 12px 14px;
    background: #fff;
    border-radius: 20px;
    box-shadow: 0 22px 48px rgba(27, 67, 50, 0.14);
    text-decoration: none;
    color: var(--color-text);
    transform: rotate(var(--tilt));
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .hero2__tile:hover {
    transform: rotate(var(--tilt)) translateY(-6px);
    box-shadow: 0 28px 56px rgba(27, 67, 50, 0.18);
    color: var(--color-text);
  }
  .hero2__tile--1 { width: 48%; left: 18%; top: 12%; z-index: 3; }
  .hero2__tile--2 { width: 34%; left: 0; bottom: 2%; z-index: 2; --tilt: -4deg; }
  .hero2__tile--3 { width: 32%; right: 0; top: 2%; z-index: 4; --tilt: 4deg; }
  .hero2__tile-img {
    position: relative;
    aspect-ratio: 1 / 1;
    background: #F7F2EA;
    border-radius: 14px;
    overflow: hidden;
  }
  .hero2__tile-img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 8%;
    mix-blend-mode: multiply;
  }
  .hero2__tile-name {
    margin-top: 10px;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hero2__tile-price {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  @media (max-width: 992px) {
    .hero2 {
      padding: 32px 0 36px;
    }
    .hero2__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 26px;
    }
    .hero2__content {
      text-align: center;
    }
    .hero2__text {
      margin-left: auto;
      margin-right: auto;
    }
    .hero2__actions,
    .hero2__chips {
      justify-content: center;
    }
    .hero2__stage {
      aspect-ratio: auto;
      max-width: 560px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
    }
    .hero2__halo,
    .hero2__leaf {
      display: none;
    }
    .hero2__tile,
    .hero2__tile:hover {
      position: static;
      width: auto;
      transform: none;
      padding: 8px 8px 10px;
      border-radius: 16px;
      box-shadow: 0 8px 22px rgba(27, 67, 50, 0.10);
    }
    .hero2__tile-name {
      font-size: 0.74rem;
      margin-top: 7px;
    }
    .hero2__tile-price {
      font-size: 0.76rem;
    }
  }
  @media (max-width: 640px) {
    .hero2 {
      padding: 22px 0 26px;
    }
    .hero2__eyebrow {
      font-size: 0.66rem;
      padding: 6px 12px;
      margin-bottom: 14px;
    }
    .hero2__title {
      font-size: clamp(1.75rem, 7.6vw, 2.2rem);
      margin-bottom: 12px;
    }
    .hero2__text {
      font-size: 0.95rem;
      line-height: 1.6;
      margin-bottom: 18px;
    }
    .hero2__actions {
      gap: 10px;
      margin-bottom: 18px;
    }
    .hero2__actions .btn {
      flex: 1 1 0;
      padding: 13px 14px;
      font-size: 0.82rem;
    }
    .hero2__chips {
      gap: 6px;
    }
    .hero2__chip {
      padding: 6px 10px;
      font-size: 0.74rem;
    }
    .hero2__chip svg {
      width: 13px;
      height: 13px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero2__tile,
    .hero2__tile:hover {
      transition: none;
    }
  }
{%- endstyle -%}

<section class="hero2" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="hero2__grid">
      <div class="hero2__content">
        {%- if section.settings.label != blank -%}
          <span class="hero2__eyebrow">{% render 'policy-icon', name: 'leaf' %}{{ section.settings.label }}</span>
        {%- endif -%}

        <h1 class="hero2__title">{{ section.settings.title | newline_to_br }}</h1>

        {%- if section.settings.text != blank -%}
          <p class="hero2__text">{{ section.settings.text }}</p>
        {%- endif -%}

        <div class="hero2__actions">
          {%- if section.settings.button_text != blank -%}
            <a href="{{ section.settings.button_link | default: '/collections/best-sellers' }}" class="btn btn--primary btn--lg">{{ section.settings.button_text }}</a>
          {%- endif -%}
          {%- if section.settings.button_text_2 != blank -%}
            <a href="{{ section.settings.button_link_2 | default: '/pages/about-us' }}" class="btn btn--secondary btn--lg">{{ section.settings.button_text_2 }}</a>
          {%- endif -%}
        </div>

        {%- if section.settings.show_features and section.blocks.size > 0 -%}
          <ul class="hero2__chips">
            {%- for block in section.blocks -%}
              {%- if block.type == 'feature' and block.settings.text != blank -%}
                <li class="hero2__chip" {{ block.shopify_attributes }}>{% render 'policy-icon', name: 'shield' %}{{ block.settings.text }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="hero2__stage">
        <span class="hero2__halo" aria-hidden="true"></span>
        <span class="hero2__leaf hero2__leaf--a" aria-hidden="true">{% render 'policy-icon', name: 'leaf' %}</span>
        <span class="hero2__leaf hero2__leaf--b" aria-hidden="true">{% render 'policy-icon', name: 'leaf' %}</span>
        {%- assign tile_index = 0 -%}
        {%- for handle in pick_handles -%}
          {%- assign p = all_products[handle] -%}
          {%- if p != blank and p.featured_image != blank and tile_index < 3 -%}
            {%- assign tile_index = tile_index | plus: 1 -%}
            {%- capture tile_name -%}{%- render 'product-short-title', title: p.title -%}{%- endcapture -%}
            <a href="{{ p.url }}" class="hero2__tile hero2__tile--{{ tile_index }}">
              <span class="hero2__tile-img">
                <img
                  src="{{ p.featured_image | image_url: width: 520 }}"
                  srcset="{{ p.featured_image | image_url: width: 260 }} 260w, {{ p.featured_image | image_url: width: 520 }} 520w"
                  sizes="(max-width: 992px) 30vw, {% if tile_index == 1 %}280px{% else %}200px{% endif %}"
                  alt="{{ tile_name | strip | escape }}"
                  width="{{ p.featured_image.width }}"
                  height="{{ p.featured_image.height }}"
                  {% if tile_index == 1 %}fetchpriority="high"{% endif %}
                  loading="eager"
                >
              </span>
              <span class="hero2__tile-name">{{ tile_name | strip }}</span>
              <span class="hero2__tile-price">{% render 'inr-price', cents: p.price %}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "hero-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Since 1999 · Bhavnagar, Gujarat"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "Authentic Ayurveda,\nmade with pharmaceutical care"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "84+ time-tested formulations — from Harry and Cofula to VedaCold — trusted by 3 Lakh+ customers across 22+ states."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Primary Button Text",
      "default": "Shop Bestsellers"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_text_2",
      "label": "Secondary Button Text",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary Button Link"
    },
    {
      "type": "checkbox",
      "id": "show_features",
      "label": "Show trust chips",
      "default": true
    },
    {
      "type": "header",
      "content": "Featured products",
      "info": "Shown as product tiles. Leave blank to use the first products of the Bestsellers collection."
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Main product"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Second product"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Third product"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Trust chip",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "GMP-certified manufacturing"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "feature", "settings": { "text": "GMP-certified manufacturing" } },
        { "type": "feature", "settings": { "text": "Free shipping above ₹400" } },
        { "type": "feature", "settings": { "text": "Cash on Delivery" } }
      ]
    }
  ]
}
{% endschema %}
