{%- comment -%}
  New Arrivals Section — same product card as the rest of the store
  (snippets/product-card.liquid) with a "New" badge; grid on desktop,
  swipeable row on phones (.prow in theme.css).
{%- endcomment -%}

<section class="new-arrivals-large {% if section.settings.alt_background %}section--alt{% endif %}">
  <div class="container">
    <div class="section-header">
      {%- if section.settings.label != blank -%}
        <span class="section-header__label">{{ section.settings.label }}</span>
      {%- endif -%}
      <h2 class="section-header__title">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="section-header__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    {%- liquid
      if section.settings.collection != blank
        assign products = section.settings.collection.products
      else
        assign products = collections['all'].products
      endif
    -%}

    <div class="prow">
      {%- for product in products limit: section.settings.products_count -%}
        {%- render 'product-card', product: product, badge: 'New', show_vendor: section.settings.show_vendor -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.button_text != blank -%}
      <div class="text-center new-arrivals-large__footer">
        <a href="{{ section.settings.button_link | default: section.settings.collection.url | default: routes.all_products_collection_url }}" class="btn btn--secondary">
          {{ section.settings.button_text }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .new-arrivals-large {
    padding: clamp(48px, 6vw, 80px) 0;
    background: #FDF8F0;
  }

  .new-arrivals-large.section--alt {
    background: #fff;
  }

  .new-arrivals-large .section-header {
    margin-bottom: 36px;
  }

  .new-arrivals-large__footer {
    margin-top: 36px;
  }

  @media (max-width: 768px) {
    .new-arrivals-large .section-header {
      margin-bottom: 22px;
    }
    .new-arrivals-large__footer {
      margin-top: 18px;
    }
  }
</style>

{% schema %}
{
  "name": "New Arrivals Large",
  "tag": "section",
  "class": "new-arrivals-large-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "alt_background",
      "label": "Use Alternative Background",
      "default": false
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Just Launched"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "New Arrivals"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Discover our latest Ayurvedic formulations crafted with ancient wisdom and modern science."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Number of Products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Vendor",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "View All New Products"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "New Arrivals Large"
    }
  ]
}
{% endschema %}
