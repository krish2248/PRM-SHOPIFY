{%- comment -%}
  Shipping Policy page (template: page.shipping-policy).
  Shared styling lives in snippets/policy-page-assets.liquid.
{%- endcomment -%}
{%- render 'policy-page-assets' -%}
{%- liquid
  assign legal_name = section.settings.legal_name | default: 'PRM & Company'
  assign tracking_url = section.settings.tracking_url | default: 'https://ship.nimbuspost.com/tracking'
  assign free_above = settings.free_shipping_threshold | default: 400
-%}

<div class="policy-page" data-section-id="{{ section.id }}">
  <div class="container">
    <header class="policy-header">
      <span class="policy-eyebrow">{{ section.settings.eyebrow | default: 'Customer Care' }}</span>
      <h1 class="policy-title">{{ page.title | default: 'Shipping Policy' }}</h1>
      <p class="policy-subtitle">{{ section.settings.subtitle }}</p>
      <div class="policy-meta">
        <span class="policy-chip">{% render 'policy-icon', name: 'calendar' %}Last updated: {{ section.settings.last_updated }}</span>
        <span class="policy-chip">{% render 'policy-icon', name: 'map' %}Ships from Bhavnagar, Gujarat</span>
        <span class="policy-chip">{% render 'policy-icon', name: 'truck' %}Delivered via NimbusPost</span>
      </div>
    </header>

    <div class="policy-highlights">
      <div class="policy-highlight">
        <span class="policy-icon">{% render 'policy-icon', name: 'truck' %}</span>
        <h3>Free Shipping</h3>
        <p>On all orders above ₹{{ free_above }}, anywhere in India.</p>
      </div>
      <div class="policy-highlight">
        <span class="policy-icon">{% render 'policy-icon', name: 'clock' %}</span>
        <h3>Dispatch in 1–2 Days</h3>
        <p>Orders are packed and handed to the courier within 1–2 business days.</p>
      </div>
      <div class="policy-highlight">
        <span class="policy-icon">{% render 'policy-icon', name: 'navigation' %}</span>
        <h3>Live Tracking</h3>
        <p>Tracking link by SMS &amp; email as soon as your order ships.</p>
      </div>
      <div class="policy-highlight">
        <span class="policy-icon">{% render 'policy-icon', name: 'card' %}</span>
        <h3>Cash on Delivery</h3>
        <p>Available on eligible pincodes — or pay securely online via Razorpay.</p>
      </div>
    </div>

    <div class="policy-layout">
      <aside class="policy-aside">
        <nav class="policy-toc" aria-label="On this page">
          <p class="policy-label">On this page</p>
          <ol>
            <li><a href="#delivery-areas">Where We Deliver</a></li>
            <li><a href="#charges">Shipping Charges</a></li>
            <li><a href="#timelines">Dispatch &amp; Delivery Times</a></li>
            <li><a href="#tracking">Tracking Your Order</a></li>
            <li><a href="#cod">Cash on Delivery</a></li>
            <li><a href="#attempts">Failed Deliveries</a></li>
            <li><a href="#delays">Delays &amp; Damaged Parcels</a></li>
            <li><a href="#contact">Contact &amp; Grievances</a></li>
          </ol>
        </nav>
        {%- render 'policy-help' -%}
      </aside>

      <article class="policy-body">
        <div class="policy-intro">
          <p>Every PRM HerboVilla order is packed at our facility in Bhavnagar, Gujarat and shipped through <strong>NimbusPost</strong>, our logistics partner. NimbusPost assigns each parcel to the most suitable courier for your pincode — such as Delhivery, Blue Dart, DTDC, Ekart or Xpressbees — so it reaches you as quickly as possible.</p>
        </div>

        <section class="policy-section" id="delivery-areas">
          <span class="policy-num">01</span>
          <h2>Where We Deliver</h2>
          <p>We deliver to all serviceable pincodes across India — metros, tier 2 and tier 3 cities, and most rural areas with courier access. Enter your pincode at checkout to confirm delivery to your address.</p>
          <p>We currently ship within India only.</p>
        </section>

        <section class="policy-section" id="charges">
          <span class="policy-num">02</span>
          <h2>Shipping Charges</h2>
          <div class="policy-table-wrap">
            <table class="policy-table">
              <thead>
                <tr>
                  <th scope="col">Order value</th>
                  <th scope="col">Shipping</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td data-label="Order value">₹{{ free_above }} and above</td>
                  <td data-label="Shipping"><strong>FREE</strong></td>
                </tr>
                <tr>
                  <td data-label="Order value">Below ₹{{ free_above }}</td>
                  <td data-label="Shipping">A small delivery charge may apply — always shown at checkout before you pay</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p>There are no hidden charges: the total you see at checkout, including GST and any shipping or Cash on Delivery charge, is the total you pay.</p>
        </section>

        <section class="policy-section" id="timelines">
          <span class="policy-num">03</span>
          <h2>Dispatch &amp; Delivery Times</h2>
          <p>Orders are dispatched within <strong>1–2 business days</strong>. After dispatch, delivery usually takes:</p>
          <div class="policy-table-wrap">
            <table class="policy-table">
              <thead>
                <tr>
                  <th scope="col">Destination</th>
                  <th scope="col">Estimated delivery after dispatch</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td data-label="Destination">Metro cities (Mumbai, Delhi, Bengaluru, Chennai, Kolkata, Hyderabad, Pune)</td>
                  <td data-label="Estimated delivery after dispatch">3–5 business days</td>
                </tr>
                <tr>
                  <td data-label="Destination">Tier 2 cities</td>
                  <td data-label="Estimated delivery after dispatch">5–7 business days</td>
                </tr>
                <tr>
                  <td data-label="Destination">Tier 3 towns and rural areas</td>
                  <td data-label="Estimated delivery after dispatch">7–10 business days</td>
                </tr>
                <tr>
                  <td data-label="Destination">Remote and hilly areas (including the North-East, J&amp;K and islands)</td>
                  <td data-label="Estimated delivery after dispatch">10–14 business days</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="policy-fine">Business days are Monday to Saturday, excluding public holidays. Orders placed on Sundays or holidays are processed the next business day.</p>
        </section>

        <section class="policy-section" id="tracking">
          <span class="policy-num">04</span>
          <h2>Tracking Your Order</h2>
          <ol class="policy-steps">
            <li>
              <span class="policy-step-num">1</span>
              <div>
                <h4>Order confirmation</h4>
                <p>You receive an email (and SMS, where available) as soon as your order is placed.</p>
              </div>
            </li>
            <li>
              <span class="policy-step-num">2</span>
              <div>
                <h4>Shipment notification</h4>
                <p>When your order ships, we send the courier name, AWB (tracking) number and tracking link.</p>
              </div>
            </li>
            <li>
              <span class="policy-step-num">3</span>
              <div>
                <h4>Track any time</h4>
                <p>Use the tracking link in your message, check your order in your account, or enter your AWB number on NimbusPost's tracking page.</p>
              </div>
            </li>
          </ol>
          <a class="policy-btn policy-btn--inline" href="{{ tracking_url }}" target="_blank" rel="noopener">Track on NimbusPost {% render 'policy-icon', name: 'external' %}</a>
        </section>

        <section class="policy-section" id="cod">
          <span class="policy-num">05</span>
          <h2>Cash on Delivery (COD)</h2>
          <ul class="policy-list">
            <li>COD is available on eligible pincodes and order values; availability and any COD charge are shown at checkout.</li>
            <li>Please keep the exact amount ready. Many of our courier partners also accept UPI at the doorstep.</li>
            <li>We may call or message you to confirm a COD order before dispatch.</li>
            <li>Repeatedly refusing COD orders may lead to COD being turned off for your future orders.</li>
          </ul>
          <p>Prefer to pay online? UPI, cards, net banking and wallets are processed securely by <strong>Razorpay</strong>.</p>
        </section>

        <section class="policy-section" id="attempts">
          <span class="policy-num">06</span>
          <h2>Failed Delivery Attempts</h2>
          <p>Our courier partners usually make up to three delivery attempts and may call you before delivering. If a parcel can't be delivered — because the address is incomplete, the phone is unreachable or the delivery is refused — it is returned to us.</p>
          <p>We will contact you to arrange re-delivery or a refund. Refunds for prepaid orders that come back to us follow our {% render 'policy-link', key: 'returns', label: 'Returns, Refund &amp; Exchange Policy' %}.</p>
        </section>

        <section class="policy-section" id="delays">
          <span class="policy-num">07</span>
          <h2>Delays &amp; Damaged Parcels</h2>
          <ul class="policy-list">
            <li>Delivery dates are estimates. Festivals, sale periods, extreme weather, strikes and local restrictions can cause delays; we will keep you informed.</li>
            <li>If your order arrives after the latest estimated delivery date for reasons within our control, you may refuse it or return it unopened for a full refund.</li>
            <li>If the outer packaging looks damaged or tampered with, please refuse the parcel or tell the delivery agent, and contact us within 48 hours.</li>
          </ul>
          <p>Damaged, wrong or missing items are always replaced or refunded — see our {% render 'policy-link', key: 'returns', label: 'Returns, Refund &amp; Exchange Policy' %}.</p>
        </section>

        <section class="policy-section" id="contact">
          <span class="policy-num">08</span>
          <h2>Contact &amp; Grievance Redressal</h2>
          {%- render 'policy-grievance',
            legal_name: legal_name,
            officer_name: section.settings.grievance_name,
            officer_designation: section.settings.grievance_designation,
            officer_email: section.settings.grievance_email,
            officer_phone: section.settings.grievance_phone
          -%}
        </section>
      </article>
    </div>

    {%- render 'policy-related', current: 'shipping' -%}
  </div>
</div>

{% schema %}
{
  "name": "Shipping Policy",
  "tag": "section",
  "class": "section-shipping-policy",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label above title",
      "default": "Customer Care"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "How we pack, ship and deliver your Ayurvedic care — anywhere in India."
    },
    {
      "type": "text",
      "id": "last_updated",
      "label": "Last updated date",
      "default": "21 October 2026"
    },
    {
      "type": "url",
      "id": "tracking_url",
      "label": "Order tracking page",
      "info": "Defaults to NimbusPost's tracking page."
    },
    {
      "type": "header",
      "content": "Business & grievance details"
    },
    {
      "type": "text",
      "id": "legal_name",
      "label": "Registered business name",
      "info": "Must match your GST registration.",
      "default": "PRM & Company"
    },
    {
      "type": "text",
      "id": "grievance_name",
      "label": "Grievance Officer name",
      "info": "Required by the Consumer Protection (E-Commerce) Rules, 2020."
    },
    {
      "type": "text",
      "id": "grievance_designation",
      "label": "Grievance Officer designation"
    },
    {
      "type": "text",
      "id": "grievance_email",
      "label": "Grievance Officer email",
      "info": "Leave blank to use the store contact email."
    },
    {
      "type": "text",
      "id": "grievance_phone",
      "label": "Grievance Officer phone",
      "info": "Leave blank to use the store contact phone."
    }
  ],
  "presets": [
    {
      "name": "Shipping Policy"
    }
  ]
}
{% endschema %}
