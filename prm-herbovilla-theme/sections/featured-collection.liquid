{% comment %}
  Featured Collection Section - Shows products from a specific collection.
  Cards come from snippets/product-card.liquid; the row is a grid on desktop
  and a swipeable row on phones (.prow in theme.css). In-stock products are
  listed first so sold-out items never take the first slots.
{% endcomment %}
{%- liquid
  assign eyebrow = section.settings.label | default: section.settings.subtitle
  assign intro = section.settings.text | default: section.settings.description
  assign source = section.settings.collection
  if source == blank
    assign source = collections['all']
  endif
  assign limit = section.settings.products_count
-%}

<section class="featured-collection section-padding" id="featured-{{ section.id }}">
  <div class="container">
    {% if section.settings.title != blank or eyebrow != blank %}
      <div class="section-header {% if section.settings.header_alignment == 'left' %}text-left{% else %}text-center{% endif %}">
        {% if eyebrow != blank %}
          <span class="section-subtitle">{{ eyebrow }}</span>
        {% endif %}
        {% if section.settings.title != blank %}
          <h2 class="section-title">{{ section.settings.title }}</h2>
        {% endif %}
        {% if intro != blank %}
          <p class="section-description">{{ intro }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if source.products_count > 0 %}
      <div class="prow">
        {%- assign shown = 0 -%}
        {%- for product in source.products -%}
          {%- if product.available and shown < limit -%}
            {%- assign card_lazy = true -%}
            {%- if shown < 2 -%}{%- assign card_lazy = false -%}{%- endif -%}
            {%- render 'product-card', product: product, show_vendor: section.settings.show_vendor, lazy: card_lazy -%}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if shown < limit -%}
          {%- for product in source.products -%}
            {%- if product.available == false and shown < limit -%}
              {%- render 'product-card', product: product, show_vendor: section.settings.show_vendor -%}
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>

      {% if section.settings.show_view_all %}
        <div class="featured-collection__footer text-center">
          <a href="{{ source.url }}" class="btn btn--secondary">
            {{ section.settings.view_all_text | default: 'View All Products' }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      {% endif %}
    {% else %}
      <div class="featured-collection__empty">
        <p>Select a collection to display products.</p>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .featured-collection {
    padding: 72px 0;
    background-color: {{ section.settings.background_color }};
  }

  .featured-collection .section-header {
    margin-bottom: 40px;
  }

  .featured-collection .section-subtitle {
    display: block;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-primary);
    margin-bottom: 10px;
    font-weight: 600;
  }

  .featured-collection .section-title {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, 40px);
    color: var(--color-text);
    margin: 0 0 12px;
  }

  .featured-collection .section-description {
    max-width: 600px;
    color: var(--color-text-light);
    font-size: 16px;
    line-height: 1.6;
  }

  .featured-collection .section-header.text-center .section-description {
    margin: 0 auto;
  }

  .featured-collection__footer {
    margin-top: 40px;
  }

  .featured-collection__footer .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .featured-collection__footer .btn svg {
    transition: transform 0.3s ease;
  }

  .featured-collection__footer .btn:hover svg {
    transform: translateX(4px);
  }

  .featured-collection__empty {
    text-align: center;
    padding: 60px 20px;
    background: #f8f9fa;
    border-radius: 12px;
    color: var(--color-text-light);
  }

  @media (max-width: 768px) {
    .featured-collection {
      padding: 40px 0 36px;
    }
    .featured-collection .section-header {
      margin-bottom: 22px;
    }
    .featured-collection__footer {
      margin-top: 18px;
    }
  }
</style>

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Small label above title",
      "info": "Leave blank to use the subtitle below."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Our Products"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Featured Products"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description (legacy)"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FDF8F0"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show secondary image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All button text",
      "default": "View All Products"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection",
      "settings": {
        "subtitle": "Our Products",
        "title": "Featured Products",
        "products_count": 4,
        "columns": 4
      }
    }
  ]
}
{% endschema %}
