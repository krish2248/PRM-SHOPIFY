        },
        {
          "type": "text",
          "id": "name",
          "label": "Ingredient name",
          "default": "Ashwagandha"
        },
        {
          "type": "text",
          "id": "benefit",
          "label": "Benefit / description",
          "default": "Reduces stress and boosts immunity"
        }
      ]
    },
    {
      "type": "usage_step",
      "name": "Usage Step",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Step text",
          "default": "Take 1-2 tablets twice daily"
        }
      ]
    },
    {
      "type": "review",
      "name": "Customer Review",
      "settings": [
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Customer name",
          "default": "Customer"
        },
        {
          "type": "text",
          "id": "reviewer_location",
          "label": "Location",
          "default": "India"
