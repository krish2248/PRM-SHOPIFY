    {
      "type": "header",
      "content": "Product Showcase"
    },
    {
      "type": "text",
      "id": "showcase_heading",
      "label": "Showcase heading",
      "default": "Premium Ayurvedic Wellness"
    },
    {
      "type": "textarea",
      "id": "showcase_text",
      "label": "Showcase description",
      "default": "Experience the power of traditional Ayurvedic herbs combined with modern science for optimal health and wellness."
    },
    {
      "type": "header",
      "content": "Video Testimonials"
    },
    {
      "type": "text",
      "id": "youtube_product_url",
      "label": "YouTube Product Video URL",
      "info": "YouTube URL for the product overview video"
