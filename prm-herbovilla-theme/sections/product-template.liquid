        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "review_title",
          "label": "Review title"
        },
        {
          "type": "textarea",
          "id": "review_body",
          "label": "Review text",
          "default": "Great product!"
        },
        {
          "type": "text",
          "id": "review_date",
          "label": "Date",
          "default": "May 2026"
        }
      ]
    },
    {
      "type": "research_ingredient",
      "name": "Research Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Ingredient image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Ashwagandha"
        },
        {
          "type": "text",
          "id": "scientific_name",
          "label": "Scientific name",
          "default": "Withania somnifera"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Renowned adaptogen that reduces cortisol levels and enhances physical and mental performance."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Research badge",
          "default": "Clinically Studied"
        }
      ]
